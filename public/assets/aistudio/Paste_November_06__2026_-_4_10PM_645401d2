            type="button" 
            onclick="copyUserWords(false)" 
            class="text-xs font-bold text-nishi-maroon hover:text-nishi-dark underline py-1 cursor-pointer"
          >
            📋 Salin Ulang 3 Kata
          </button>
          <span class="text-nishi-maroon/30">•</span>
          <button 
            type="button" 
            onclick="resetFlow()" 
            class="text-xs font-bold text-nishi-maroon/70 hover:text-nishi-maroon underline py-1 cursor-pointer"
          >
            ← Ganti 3 Kata
          </button>
        </div>

      </section>

      <!-- Clean Production Footer -->
      <footer class="pt-3 border-t border-nishi-maroon/15 text-center">
        <p class="text-[11px] text-nishi-maroon/65 font-semibold">
          🐾 Nishi • Syarat & ketentuan berlaku (1x klaim Free Gelato / review)
        </p>
      </footer>

    </div>
  </main>

  <script>
    // State Variables
    let currentThreeWords = '';
    const inputEl = document.getElementById('three-words-input');
    const counterEl = document.getElementById('word-counter');
    const errorEl = document.getElementById('error-msg');
    const inputContainer = document.getElementById('input-container');
    const stepLocked = document.getElementById('step-locked');
    const stepUnlocked = document.getElementById('step-unlocked');
    const displayWordsEl = document.getElementById('display-three-words');

    // Count words and update badge
    function countWords(str) {
      const cleaned = str.trim().replace(/,/g, ' ');
      if (!cleaned) return 0;
      return cleaned.split(/\s+/).filter(Boolean).length;
    }

    function handleInput(val) {
      errorEl.classList.add('hidden');
      const count = countWords(val);
      counterEl.textContent = `${Math.min(count, 3)}/3 Kata`;
      if (count >= 3) {
        counterEl.classList.add('text-emerald-700');
      } else {
        counterEl.classList.remove('text-emerald-700');
      }
    }

    // Fill input when user taps a quick preset pill
    function fillPreset(text) {
      inputEl.value = text;
      handleInput(text);
      inputEl.focus();
    }

    // Copy text helper compatible with iFrame & mobile browsers
    function copyToClipboard(text) {
      try {
        const tempInput = document.createElement('textarea');
        tempInput.value = text;
        tempInput.style.position = 'fixed';
        tempInput.style.opacity = '0';
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        return true;
      } catch (e) {
        return false;
      }
    }

    // Toast notification trigger
    let toastTimeout;
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-message');
      toastMsg.textContent = message;
      toast.classList.remove('opacity-0', '-translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', '-translate-y-3');
      }, 2600);
    }

    // Step 1 -> Step 2 Unlock Handler
    function unlockSecret() {
      const rawText = inputEl.value.trim();
      const wordCount = countWords(rawText);

      // Require at least 2-3 words or non-empty input
      if (!rawText || wordCount < 2) {
        errorEl.classList.remove('hidden');
        inputContainer.classList.remove('animate-shake');
        void inputContainer.offsetWidth; // trigger reflow
        inputContainer.classList.add('animate-shake');
        inputEl.focus();
        return;
      }

      currentThreeWords = rawText;
      displayWordsEl.textContent = `"${currentThreeWords}"`;

      // Auto-copy formatted review starter to clipboard
      const reviewStarter = `${currentThreeWords} — `;
      copyToClipboard(reviewStarter);

      // Switch View to Unlocked State
      stepLocked.classList.add('hidden');
      stepUnlocked.classList.remove('hidden');
      stepUnlocked.classList.add('flex', 'animate-pop');

      // Launch Confetti & Show Toast
      fireConfetti();
      showToast('Rahasia terbuka & 3 katamu otomatis disalin!');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Re-copy user's 3 words
    function copyUserWords(silentRedirect = false) {
      if (!currentThreeWords) return;
      copyToClipboard(currentThreeWords);
      if (silentRedirect) {
        showToast('3 kata disalin! Tinggal tempel (paste) di Google Review ⭐');
      } else {
        showToast('Teks 3 kata berhasil disalin ulang! 📋');
      }
    }

    // Reset back to Step 1
    function resetFlow() {
      stepUnlocked.classList.add('hidden');
      stepUnlocked.classList.remove('flex', 'animate-pop');
      stepLocked.classList.remove('hidden');
      inputEl.value = '';
      handleInput('');
    }

    // Lightweight Canvas Confetti in Nishi Maroon & Gold colors
    function fireConfetti() {
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const pieces = [];
      const colors = ['#7B1B29', '#F59E0B', '#F4A2AD', '#10B981', '#9E2A3B'];

      for (let i = 0; i < 65; i++) {
        pieces.push({
          x: canvas.width / 2 + (Math.random() - 0.5) * 140,
          y: canvas.height / 2 - 60,
          vx: (Math.random() - 0.5) * 12,
          vy: Math.random() * -12 - 4,
          size: Math.random() * 8 + 5,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vr: (Math.random() - 0.5) * 12,
          gravity: 0.35
        });
      }

      let frame = 0;
      function updateConfetti() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.rotation += p.vr;

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
          ctx.restore();
        });

        frame++;
        if (frame < 95) {
          requestAnimationFrame(updateConfetti);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      requestAnimationFrame(updateConfetti);
    }
  </script>
</body>
</html>