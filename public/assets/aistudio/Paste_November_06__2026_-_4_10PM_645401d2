  <style>
    body {
      background-color: #EFE6DD;
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #7B1B29;
      overflow-x: hidden;
    }

    /* Subtle Japanese Seigaiha / Dot pattern inspired background */
    .bg-kawaii-pattern {
      background-color: #FDF8F2;
      background-image: radial-gradient(#7B1B29 0.75px, transparent 0.75px), radial-gradient(#7B1B29 0.75px, #FDF8F2 0.75px);
      background-size: 28px 28px;
      background-position: 0 0, 14px 14px;
      background-attachment: local;
    }

    .pattern-overlay {
      background: linear-gradient(180deg, rgba(253,248,242,0.88) 0%, rgba(253,248,242,0.96) 40%, rgba(253,248,242,0.98) 100%);
    }

    /* Custom Animations */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-6px) rotate(1deg); }
    }
    .animate-float {
      animation: floatSlow 3.2s ease-in-out infinite;
    }

    @keyframes popBounce {
      0% { transform: scale(0.8); opacity: 0; }
      70% { transform: scale(1.04); }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popBounce 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }
    .animate-shake {
      animation: shake 0.35s ease-in-out;
    }

    /* Ticket Cutout Styling */
    .ticket-card {
      position: relative;
      border: 2.5px dashed #7B1B29;
    }
    .ticket-notch-left, .ticket-notch-right {
      position: absolute;
      top: 50%;
      width: 24px;
      height: 24px;
      background-color: #FDF8F2;
      border-radius: 9999px;
      transform: translateY(-50%);
    }
    .ticket-notch-left {
      left: -14px;
      border-right: 2.5px solid #7B1B29;
    }
    .ticket-notch-right {
      right: -14px;
      border-left: 2.5px solid #7B1B29;
    }

    /* Comic 3D button press effect */
    .btn-3d {
      box-shadow: 0 5px 0 #4A0D16;
      transition: all 0.12s ease;
    }
    .btn-3d:active {
      transform: translateY(4px);
      box-shadow: 0 1px 0 #4A0D16;
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 5px 0 #4A0D16, 0 0 0 0 rgba(123, 27, 41, 0.45); }
      50% { box-shadow: 0 5px 0 #4A0D16, 0 0 0 8px rgba(123, 27, 41, 0); }
    }
    .btn-pulse {
      animation: pulseGlow 2s infinite;
    }

    /* Confetti Canvas */
    #confetti-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 50;
